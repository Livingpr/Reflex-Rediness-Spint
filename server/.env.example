# Copy this file to .env for local development and fill in real values.
# On Render, set these as Environment Variables in the dashboard instead
# (render.yaml already wires DATABASE_URL and JWT_SECRET automatically).

# Postgres connection string.
# Local dev example:   postgresql://postgres:postgres@localhost:5432/reflex
# Render provides this automatically when you attach a Render Postgres
# database to the web service - copy its "Internal Database URL".
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reflex

# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

PORT=4000

# Only needed in local dev, when the Vite client (port 5173) calls an API
# running on a different port than itself. Leave unset in production - the
# server serves the built client itself, so there's no cross-origin request.
CLIENT_ORIGIN=http://localhost:5173

NODE_ENV=development
